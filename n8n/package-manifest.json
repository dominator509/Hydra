{
  "name": "n8n-nodes-hydra",
  "version": "0.1.0",
  "description": "n8n nodes for Hydra — trigger and action nodes to integrate Hydra envelope workflows",
  "keywords": [
    "n8n-community-node-package",
    "hydra",
    "automation"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": "Hydra",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "install": "n8n-node-dev install",
    "package": "pnpm build && pnpm pack",
    "lint": "eslint nodes --ext .ts"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/hydra/HydraTrigger.node.js",
      "dist/nodes/hydra/HydraAction.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.0.0"
  }
}
