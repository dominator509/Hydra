{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                kind,\n                tenant_id,\n                body as \"body!: Json<Value>\",\n                origin,\n                origin_ref,\n                version\n            FROM entity\n            WHERE tenant_id = $1\n              AND kind = $2\n              AND deleted_at IS NULL\n              AND ($3::uuid IS NULL OR id > $3)\n            ORDER BY id\n            LIMIT $4\n            ",
