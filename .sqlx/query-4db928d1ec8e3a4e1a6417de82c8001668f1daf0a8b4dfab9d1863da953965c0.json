{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                event_id,\n                subject,\n                event as \"event!: Json<Value>\",\n                created_at,\n                published_at,\n                attempt_count,\n                last_error,\n                parked_at,\n                jetstream_sequence,\n                claim_token,\n                claimed_at,\n                trace_context as \"trace_context: Json<Value>\"\n            FROM outbox\n            WHERE id > $1\n              AND parked_at IS NULL\n            ORDER BY id ASC\n            LIMIT $2\n            ",
