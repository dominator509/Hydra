{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.id, u.tenant_id, u.username, u.display_name, r.role,\n                   u.disabled_at, u.created_at, u.updated_at\n            FROM hydra_user u\n            JOIN hydra_role r ON r.user_id = u.id AND r.tenant_id = u.tenant_id\n            WHERE u.id = $1\n              AND u.tenant_id = $2\n              AND u.auth_source = 'operator'\n            ",
