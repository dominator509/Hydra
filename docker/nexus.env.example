# Nexus-connected Compose example. Replace every REPLACE_* value before boot.
HYDRA_TAG=local
HYDRA_ENV=staging
HYDRA_BASE_URL=https://hydra.example.com
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD
HYDRA_VAULT_KEY=REPLACE_WITH_OWNER_CONTROLLED_VAULT_KEY
HYDRA_EVENTS_NETWORK=hydra-events
RUST_LOG=info,hydra=info

NEXUS_INTEGRATION_ENABLED=true
NEXUS_OIDC_ISSUER=https://identity.nexus.example.com
NEXUS_OIDC_AUDIENCE=hydra-api
NEXUS_OIDC_JWKS_URL=https://identity.nexus.example.com/.well-known/jwks.json
NEXUS_OIDC_PUBLIC_KEY_FILE=
NEXUS_OIDC_ALLOWED_ALGORITHMS=RS256
NEXUS_ALLOWED_MCP_ORIGINS=https://nexus.example.com
NEXUS_JWKS_CACHE_SECONDS=300
NEXUS_OIDC_CLOCK_SKEW_SECONDS=30
NEXUS_MCP_MAX_REQUEST_BYTES=1048576
NEXUS_APPROVAL_AUTH_STRENGTHS=mfa

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
TK_HIT_RATIO_TARGET=0.97
TK_OUTPUT_BUDGET_BYTES=16384
