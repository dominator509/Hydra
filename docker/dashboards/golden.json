{
  "title": "Hydra Golden Signals",
  "uid": "hydra-golden",
  "description": "Request rate, error rate, latency, and envelope states — the four golden signals for operations.",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "description": "HTTP request rate by route and status code",
      "targets": [
        {
          "expr": "rate(hydra_requests_total[1m])",
          "legendFormat": "{{method}} {{path}} {{status}}"
        }
      ],
      "fieldConfig": {
        "unit": "rps",
        "min": 0
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "description": "HTTP 5xx rate as a fraction of total requests",
      "targets": [
        {
          "expr": "rate(hydra_requests_total{status=~\"5..\"}[1m]) / rate(hydra_requests_total[1m])",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "unit": "percentunit",
        "min": 0,
        "max": 1
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "gauge",
      "description": "95th percentile request latency (last 5m)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(hydra_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "unit": "s",
        "min": 0,
        "max": 5,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.15 },
            { "color": "red", "value": 0.5 }
          ]
        }
      },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 }
    },
    {
      "id": 4,
      "title": "Envelope States",
      "type": "barchart",
      "description": "Current envelope count broken down by state",
      "targets": [
        {
          "expr": "hydra_envelopes_total",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "unit": "none",
        "min": 0
      },
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 8 }
    }
  ],
  "tags": ["hydra", "golden-signals"],
  "editable": true,
  "time": { "from": "now-1h", "to": "now" }
}
